# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/olivosof/klipr.site"
PassengerBaseURI "/"
PassengerNodejs "/home/olivosof/nodevenv/klipr.site/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (skip for already-HTTPS)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ─── Serve Next.js static assets directly via Apache (bypass Passenger) ───
    # _next/static/* → .next/static/* (symlink or direct map)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]
</IfModule>

# ─── MIME type enforcement ───
<IfModule mod_mime.c>
    AddType text/css                    .css
    AddType application/javascript      .js
    AddType application/json            .json
    AddType font/woff2                  .woff2
    AddType font/woff                   .woff
    AddType font/ttf                    .ttf
    AddType image/svg+xml               .svg
    AddType image/webp                  .webp
    AddType image/x-icon                .ico
</IfModule>

# ─── Cache static assets aggressively ───
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
</IfModule>

Options -Indexes
